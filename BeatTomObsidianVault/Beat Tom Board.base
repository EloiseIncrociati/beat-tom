properties:
  note.id:
    displayName: ID
  note.platform:
    displayName: Surface
  note.type:
    displayName: Type
  note.lot:
    displayName: Lot
  note.status:
    displayName: Statut
  note.priority:
    displayName: Priorite
  note.date:
    displayName: Date
  note.assignee:
    displayName: Assigne
views:
  - type: kanban-view
    name: Status
    filters:
      and:
        - file.inFolder("Board")
        - note.type == "feature"
    order:
      - id
      - platform
      - lot
      - priority
    groupByProperty: note.status
    swimlaneProperty: note.lot
    quickAddFolder: Board
    wrapPropertyValues: false
    columnOrders:
      note.status:
        - Done
        - Roadmap
        - To Do
    columnColors:
      note.status: {}
    cardOrders:
      note.status: {}
  - type: kanban-view
    name: Bugs
    filters:
      and:
        - file.inFolder("Board")
        - note.type == "bug"
    order:
      - id
      - platform
      - priority
    groupByProperty: note.status
    swimlaneProperty: note.priority
    quickAddFolder: Board
    columnOrders:
      - Roadmap
      - To Do
      - Doing
      - Done
    columnColors:
      Doing: yellow
      Done: green
      Uncategorized: red
    cardOrders: {}
  - type: kanban-view
    name: Priorite
    filters:
      and:
        - file.inFolder("Board")
    order:
      - id
      - platform
      - status
    groupByProperty: note.priority
    quickAddFolder: Board
    columnOrders:
      - High
      - Medium
      - Low
    columnColors:
      Uncategorized: red
    cardOrders: {}
  - type: table
    name: Vue
    filters:
      and:
        - file.inFolder("Board")
    order:
      - id
      - file.name
      - platform
      - type
      - lot
      - status
      - priority
      - date
      - assignee
    sort:
      - property: id
        direction: ASC
